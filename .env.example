# Bu faylı .env adı ilə kopyalayın və dəyərləri dəyişin:  cp .env.example .env

PORT=3000

# Railway PostgreSQL/Supabase bağlantısı. Doldurulduqda server məlumatları
# xarici PostgreSQL bazasına yazır və lokal SQLite istifadə olunmur.
DATABASE_URL=

# Persistent storage path. Railway-də bunu persistent volume mount point-ə yönəldin.
# Lokal istifadə üçün boş saxlanıla bilər; default: ./data
DATA_DIR=
DATABASE_FILE=bakuservis.db

# Sessiya şifrələmə açarı - mütləq uzun, təsadüfi bir dəyərlə əvəz edin
SESSION_SECRET=deyisin-bunu-cox-uzun-tesadufi-metnle

# İlk admin hesabı (server ilk dəfə işə düşəndə, admins cədvəli boşdursa yaradılır)
ADMIN_USER=huseynmanfli844@gmail.com
ADMIN_PASS=Baku2019

# WhatsApp nömrəsi (beynəlxalq formatda, + işarəsi olmadan) - müştəri "WhatsApp" düyməsinə
# basanda birbaşa bu nömrə ilə söhbətə yönləndirilir
WHATSAPP_NUMBER=994707164142

# Gmail SMTP. Gmail App Password istifadə edin, adi hesab şifrəsi yox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=

# Telegram bot. TELEGRAM_WEBHOOK_URL internetdən əlçatan tam HTTPS URL olmalıdır.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
