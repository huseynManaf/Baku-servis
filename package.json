{
  "name": "hugu-servis",
  "version": "1.0.0",
  "description": "HUGU Servis - IT / komputer texniki xidmet sifarish platformasi",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup": "node scripts/backup.js",
    "cap:init": "npx cap init \"Hugu Servis\" com.huguservis.app --web-dir=public",
    "cap:add-android": "npx cap add android",
    "cap:open-android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "postinstall": "npm rebuild sqlite3 --build-from-source"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.4",
    "@capacitor/cli": "^5.0.4",
    "@capacitor/core": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.23.0",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
