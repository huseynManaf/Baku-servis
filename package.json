{
  "name": "bakuservis",
  "version": "1.0.0",
  "description": "Baku Servis - professional phone, laptop and server repair platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup": "node scripts/backup.js",
    "cap:init": "npx cap init \"Baku Servis\" com.bakuservis.app --web-dir=public",
    "cap:add-android": "npx cap add android",
    "cap:open-android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.4",
    "@capacitor/cli": "^5.0.4",
    "@capacitor/core": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1",
    "sqlite3": "5.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
